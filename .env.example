# Server-side Supabase configuration used by /api/waitlist and private admin APIs.
# Use the project URL and a publishable key. Never commit a service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only Vercel access token used by the private NOXA Founder Analytics API.
# Never prefix this with NEXT_PUBLIC_ and never commit a real token.
# Vercel applies environment-variable changes to new deployments; redeploy after changing this value.
VERCEL_ANALYTICS_TOKEN=your_vercel_access_token
